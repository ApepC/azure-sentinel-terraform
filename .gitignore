# ============================================================
# Azure Sentinel Infrastructure — .gitignore
# ============================================================

# --- SECRETS & CREDENTIALS (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
.netrc
secrets/
keys/
credentials.json
service-account.json
service-principal.json
azure-credentials.json
openai_key.txt
anthropic_key.txt

# Azure CLI / MSAL auth caches
.azure/
azureProfile.json
accessTokens.json
msal_token_cache.*

# --- AZURE SENTINEL ---
# Solution packaging output
*.nupkg
!Microsoft.Azure.Sentinel.KustoServices.*.nupkg
package.zip

# Local deployment / test output
deployment-output/
deploy-logs/

# Parameter files (may contain workspace/subscription IDs)
*.parameters.json
*.parameters.*.json
!*.parameters.example.json

# Exported incidents, alerts, raw logs (may contain PII)
*.incident.json
*.alert.json
*.raw.log

# CSV data — keep committed samples via negation
*.csv
!samples/*.csv
!tests/fixtures/*.csv
!eval/*.csv

# Hunting / analytics rule exports (environment-specific)
exports/
hunting-export/
rules-export/

# Workbook exports (contain workspace-specific IDs)
workbooks/exported/
*.workbook.json
!workbooks/templates/*.workbook.json

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# --- JUPYTER ---
# Preferred: run `nbstripout --install` to strip outputs on commit.
# Fallback patterns below if you can't:
.ipynb_checkpoints/
*.ipynb
!notebooks/*.ipynb
!analysis_sample.ipynb

# --- TERRAFORM ---
# State (CRITICAL — contains secrets + full infra map)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local execution dir
.terraform/
.terraform.d/

# Variables (CRITICAL — .tfvars.json is the commonly-forgotten one)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!terraform.tfvars.example
!*.tfvars.example.json

# Overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files (embed state values)
*.tfplan
*.tfplan.*

# Backend config (env-specific storage account names)
*.tfbackend

# CLI config (may contain tokens)
.terraformrc
terraform.rc

# Crash logs
crash.log
crash.*.log

# --- ARM TEMPLATES ---
# Only generated output — source templates are committed
arm/generated/

# --- LOGS ---
*.log
logs/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# --- OS ---
.DS_Store
Thumbs.db
Thumbs.db:encryptable
desktop.ini
__MACOSX/

# --- BACKUP & TEMP ---
*.bak
*.backup
*.tmp
temp/
tmp/

# --- NODE ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- EXPERIMENT TRACKING ---
wandb/
mlruns/
lightning_logs/
runs/
outputs/

# --- DIRENV ---
.envrc
.direnv/
