# ── Dev Environment Variables ─────────────────────────────────
# Copy this file to terraform.tfvars before running terraform apply:
#   cp environments/dev/terraform.tfvars.example terraform.tfvars
#
# Never commit terraform.tfvars — it's in .gitignore.

environment  = "dev"
location     = "eastus"
project_name = "sentinel"
owner        = "ApepC"

# Replace with your public IP in CIDR notation:
#   curl ifconfig.me
allowed_admin_cidr = "YOUR_IP/32"

vnet_address_space = "10.0.0.0/16"

subnets = {
  "snet-frontend"      = "10.0.1.0/24"
  "snet-backend"       = "10.0.2.0/24"
  "snet-data"          = "10.0.3.0/24"
  "snet-management"    = "10.0.4.0/24"
  "AzureBastionSubnet" = "10.0.5.0/26"
}

# ── Optional VM ───────────────────────────────────────────────
# Set to true to deploy the demo Linux VM (~$30-40/month, auto-shutdown at 23:00 UTC)
deploy_vm      = false
admin_username = "azureadmin"

# Required only if deploy_vm = true (min 12 characters)
# admin_password = "REPLACE_ME_12_CHARS_MIN"

# ── Additional tags ───────────────────────────────────────────
# These merge with the common tags applied by the root module.
tags = {
  purpose = "portfolio"
}
